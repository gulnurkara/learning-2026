public class Main {
    // Main = sınıfın adı.

    public static void main(String[] args) {   // main = programın başladığı metot.
        int number = -50;                       // number değişkeninin içine 50 değerini koydum.
        yazdir(number);                        // Burada yazdir metodunu cagırıyorum
    }

    public static void yazdir(int number) {
        // yazdir = metodun adı.
        // void = bu metot bana bir değer geri döndürmeyecek.
        // int number = metoda dışarıdan gelecek tam sayıyı tutan parametre.

        if (number > 0) {
            System.out.println("positive");
        } else if (number < 0) {
            System.out.println("negative");
        } else {
            System.out.println("zero");
        }
    }
}

