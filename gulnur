public class Practice3 {

    public static void main(String[] args){
        System.out.println(shouldWakeUp(true,-1));
    }

    public static boolean shouldWakeUp(boolean barking,int hourOfDay) {
        // boolean= true veya false geri veren veri tipi
        // shouldWakeUp = metot ,köpek havlıyor mu?
        // barking,hourOfDay = parametre

        if( hourOfDay < 0 || hourOfDay > 23){                   //    || = VEYA
            return false;
        }
        if ( barking && ( hourOfDay < 8 || hourOfDay > 22)){    //    && = VE
            return true;
        }
        return false;        // else yazmadım cunku return calıstıgında metot zaten bitiyor
    }
}
