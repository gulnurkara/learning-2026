public class Practice2 { // Practice2 adında sınıf oluşturduk

    public static void main(String[] args) { // Programın çalışmaya başladığı ana metot

        calculate(5123); // calculate metodunu cagırdık ve ona 5123 değerini gönderdik
    }

    public static void calculate(int kiloByte) {
        // calculate adında bir metot oluşturduk
        // void = geriye bir değer döndürmeyecek
        // int kiloByte = dışarıdan gelen tam sayıyı kiloByte değişkeninde tutacak

        if (kiloByte < 0) {
            System.out.println("Invalid Value");
        } else {
            int megaByte = kiloByte / 1024;
            // Kaç tam megabyte olduğunu bul,Sonucu megaByte değişkeninde tut

            int remainingKiloBytes = kiloByte % 1024;
            // % = bölümden KALANI bulur
            // 5123'ü 1024'e böldükten sonra kaç KB kaldığını bul
            // Sonucu remainingKiloBytes değişkeninde tut

            System.out.println(
                kiloByte + " KB = "      // + burada yazıları ve değişkenleri yan yana birlestiriyor
                    + megaByte + " MB and "
                    + remainingKiloBytes + " KB"
            );
        }
    }
}
