public class Practice1 {            // Practice1 = sınıfın adı. Bütün kodlarımız bu sınıfın içinde.

    public static void main(String[] args) {
        // main = programın başladığı metot.
        // void = bu metot geriye bir değer döndürmeyecegini icin

        sonucuYazdir(50.10);
        // sonucuYazdir metodunu cagırıyorum
        // 50.10 değerini bu metoda gönderiyorum.
    }


    public static void sonucuYazdir(double kilometreSaat) {
        // sonucuYazdir = metodun adı.
        // void = bu metot geriye değer döndürmeyecegı ıcın
        // kilometreSaat = metoda dışarıdan gelen değeri tutan parametre.
        // double = çünkü 50.10 gibi ondalıklı sayı gelebilir.


        if (kilometreSaat < 0) {
            System.out.println("Invalid Value");
        }
        else {
            long milSaat = milSaateCevir(kilometreSaat);
            // milSaat = değişken.
            // long = bu değişkende tam sayı tutacağım.
            // milSaateCevir metodunu çağırıyorum.
            // kilometreSaat değerini ona gönderiyorum.
            // O metodun return ile geri verdiği sonucu milSaat değişkenine koyuyorum.

            System.out.println(kilometreSaat + " km/h = "
                + milSaat + " mi/h");
        }
    }


    public static long milSaateCevir(double kilometreSaat) {
        // milSaateCevir = metodun adı.
        // long = bu metot işini bitirince tam sayı geri döndürecek.
        // kilometreSaat = dışarıdan gelen değeri tutan parametre.
        // double = ondalıklı değer kabul edebilmesi için.


        if (kilometreSaat < 0) {
            return -1;
            // return = sonucu çağırıldığı yere gonder
        }


        return Math.round(kilometreSaat / 1.609);
        // kilometreSaat değerini 1.609'a bölerek mile çevir.
        // Math.round = çıkan ondalıklı sonucu en yakın tam sayıya yuvarlayan Java'nın hazır metotu
        // return = çıkan tam sayıyı bizi çağıran yere geri gönder.
    }
}
